---
import { Font } from 'astro:assets'
import { getPosts } from '../lib/blog'
import { getProfile } from '../lib/content'
import '../styles/global.css'

interface Props {
    title: string
    description: string
    /** Keeps the page out of search results, and gives it no canonical address. */
    noindex?: boolean
    /** Dates of a Post, which link previews show as an article. */
    article?: { published: Date; modified?: Date }
}

const { title, description, noindex = false, article } = Astro.props
const { name: siteName } = await getProfile()
const hasPosts = (await getPosts()).length > 0
// Search engines and link previews need full addresses, on the canonical www domain
const canonical = noindex ? undefined : new URL(Astro.url.pathname, Astro.site)
const shareImage = new URL('/share.png', Astro.site)
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
        {canonical && <link rel="canonical" href={canonical} />}
        {noindex && <meta name="robots" content="noindex" />}
        <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        {hasPosts && (
            <link
                rel="alternate"
                type="application/rss+xml"
                title={`${siteName} — Blog`}
                href="/blog/rss.xml"
            />
        )}
        <meta property="og:type" content={article ? 'article' : 'website'} />
        <meta property="og:site_name" content={siteName} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        {canonical && <meta property="og:url" content={canonical} />}
        <meta property="og:image" content={shareImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="A smiley face drawn in black on white" />
        {article && (
            <meta property="article:published_time" content={article.published.toISOString()} />
        )}
        {article?.modified && (
            <meta property="article:modified_time" content={article.modified.toISOString()} />
        )}
        <meta name="twitter:card" content="summary_large_image" />
        {/* The italic file is for emphasis in Posts; it loads only where a page uses it */}
        <Font cssVariable="--font-archivo" preload={[{ style: 'normal' }]} />
        <slot name="head" />
    </head>
    <body>
        <slot />
    </body>
</html>
