---
import Icon from '../components/Icon.astro'
import BrandLogo from '../components/BrandLogo.astro'
import Base from '../layouts/Base.astro'
import { formatMonth } from '../lib/content'
import { getHome, resumeHref } from '../lib/home'

const { profile, aiFirst, selectedProjects, otherProjects, experience, skills, rust } =
    await getHome()
const sections = [
    { label: 'About', id: 'about' },
    { label: 'Contact', id: 'contact' },
    { label: aiFirst.heading, id: 'ai-first' },
    { label: 'Projects', id: 'projects' },
    { label: 'Experience', id: 'experience' },
    { label: 'Skills', id: 'skills' },
]
---

<Base title={`${profile.name} — Frontend Developer`} description={profile.description}>
    <nav class="sections" aria-label="Sections">
        <ul>
            {sections.map(({ label, id }) => (
                <li>
                    <a href={`#${id}`}>{label}</a>
                </li>
            ))}
        </ul>
    </nav>

    <header class="masthead" id="top">
        <h1>{profile.name}</h1>
        <p class="headline">{profile.headline}</p>
        <p class="location">
            <Icon name="pin" />
            {profile.location}
        </p>
    </header>

    <main>
        <div class="intro">
            <section class="about" aria-labelledby="about">
                <h2 id="about" class="label">
                    About
                </h2>
                <profile.About />
            </section>

            <section class="contact" aria-labelledby="contact">
                <h2 id="contact" class="label">
                    Contact
                </h2>
                <p>{profile.contactLine}</p>
                <ul class="contact-links">
                    <li>
                        <a href={`mailto:${profile.email}`}>
                            <Icon name="mail" />
                            <span>{profile.email}</span>
                        </a>
                    </li>
                    <li>
                        <a href={profile.linkedin}>
                            <BrandLogo name="LinkedIn" />
                            <span>LinkedIn</span>
                        </a>
                    </li>
                    <li>
                        <a href={profile.github}>
                            <BrandLogo name="GitHub" />
                            <span>GitHub</span>
                        </a>
                    </li>
                    <li>
                        <a href={resumeHref} download>
                            <Icon name="download" />
                            <span>Resume (PDF)</span>
                        </a>
                    </li>
                </ul>
            </section>
        </div>

        <section class="block" aria-labelledby="ai-first">
            <h2 id="ai-first" class="wall">
                {aiFirst.heading}
            </h2>
            <div class="ai-statement">
                <aiFirst.Statement />
            </div>
            <ul class="ai-points">
                {aiFirst.points.map((point) => (
                    <li class="ai-point">
                        <Icon name={point.icon} />
                        <h3>{point.title}</h3>
                        <p>{point.text}</p>
                    </li>
                ))}
            </ul>
        </section>

        <section class="block" aria-labelledby="projects">
            <h2 id="projects" class="wall">
                Projects
            </h2>
            <ol class="works">
                {selectedProjects.map((project) => (
                    <li class="work">
                        <p class="work-year">{project.year}</p>
                        <div class="work-title">
                            <h3>{project.name}</h3>
                            <p class="work-client">{project.client}</p>
                            <p class="work-agency">
                                <Icon name="via" />
                                {project.agency ? (
                                    <span>
                                        <span class="visually-hidden">via </span>
                                        {project.agency}
                                    </span>
                                ) : (
                                    <span>Freelance</span>
                                )}
                            </p>
                        </div>
                        <div class="work-body">
                            <project.Description />
                            <p class="work-stack">
                                <Icon name="layers" />
                                <span>
                                    <span class="visually-hidden">Stack: </span>
                                    {project.stack.join(', ')}
                                </span>
                            </p>
                            {project.url && (
                                <a class="work-link" href={project.url}>
                                    Visit website
                                    <Icon name="arrow-up-right" />
                                </a>
                            )}
                        </div>
                    </li>
                ))}
            </ol>

            <h3 class="label more-title">More Projects</h3>
            <ul class="more">
                {otherProjects.map((project) => (
                    <li>
                        <span class="more-year">{project.year}</span>
                        <span class="more-name">
                            {project.url ? (
                                <a href={project.url}>
                                    {project.name}
                                    <Icon name="arrow-up-right" />
                                </a>
                            ) : (
                                project.name
                            )}
                        </span>
                        <span class="more-client">{project.client}</span>
                    </li>
                ))}
            </ul>
        </section>

        <section class="block" aria-labelledby="experience">
            <h2 id="experience" class="wall">
                Experience
            </h2>
            <ol class="roles">
                {experience.map((group) => (
                    <li class="role">
                        <p class="role-dates">
                            {formatMonth(group.start)} –{' '}
                            {group.end ? formatMonth(group.end) : <strong>now</strong>}
                        </p>
                        <h3>
                            {group.url ? (
                                <a href={group.url}>{group.company}</a>
                            ) : (
                                (group.company ?? 'Freelance')
                            )}
                        </h3>
                        <ol class="progression">
                            {group.titles.map((title, index) => (
                                <li>
                                    {index > 0 && <Icon name="arrow-right" />}
                                    {title}
                                </li>
                            ))}
                        </ol>
                    </li>
                ))}
            </ol>
        </section>

        <section class="block" aria-labelledby="skills">
            <h2 id="skills" class="wall">
                Skills
            </h2>
            <div class="skills">
                {skills.map((group) => (
                    <div class="skill-group">
                        <h3 class="label">{group.name}</h3>
                        <ul>
                            {group.items.map((item) => (
                                <li>
                                    <BrandLogo name={item} />
                                    {item}
                                </li>
                            ))}
                        </ul>
                    </div>
                ))}
            </div>
        </section>

        <section class="block" aria-labelledby="rust">
            <h2 id="rust" class="wall">
                {rust.heading}
            </h2>
            <div class="beats">
                <p class="setup">{rust.setup}</p>
                <p class="confession">{rust.confession}</p>
                <p class="punchline">{rust.punchline}</p>
            </div>
            <div class="rust-answer">
                <rust.Answer />
            </div>
        </section>
    </main>

    <footer class="footer">
        <p class="sign-off">
            <a href={`mailto:${profile.email}`}>{profile.email}</a>
        </p>
        <ul class="footer-links">
            <li>
                <a href={profile.linkedin}>
                    <BrandLogo name="LinkedIn" />
                    <span>LinkedIn</span>
                </a>
            </li>
            <li>
                <a href={profile.github}>
                    <BrandLogo name="GitHub" />
                    <span>GitHub</span>
                </a>
            </li>
        </ul>
        <div class="footer-row">
            <p>
                © {new Date().getFullYear()} {profile.name}
            </p>
            <a href="#top">
                Back to top <Icon name="arrow-up" />
            </a>
        </div>
    </footer>
</Base>

<style>
    /*
     * Section nav: one row that stays at the top of the screen. Its paper runs edge to edge so
     * the page scrolls out of sight beneath it; its 2px rule keeps to the margins like every
     * other rule. Where the six links do not fit (most phones), the row scrolls sideways to the
     * screen edges, and the word cut off there shows there is more.
     */
    .sections {
        position: sticky;
        top: 0;
        z-index: 1;
        margin-inline: calc(-1 * var(--margin));
        padding-inline: var(--margin);
        background: var(--paper);
    }

    .sections::after {
        content: '';
        display: block;
        border-bottom: 2px solid var(--ink);
    }

    .sections ul {
        display: flex;
        gap: 1.25rem;
        margin-inline: calc(-1 * var(--margin));
        padding-inline: var(--margin);
        overflow-x: auto;
        scrollbar-width: none;
        font-size: 0.9375rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .sections li {
        position: relative;
        padding-block: 0.75rem;
    }

    .sections a {
        text-decoration: none;
    }

    /* The whole bar height and half of each gap are the tap area; the hover fill stays on the word */
    .sections a::after {
        content: '';
        position: absolute;
        inset: 0 -0.625rem;
    }

    /* Section links land below the bar, not under it */
    :global(html) {
        scroll-padding-top: 5rem;
    }

    /* Masthead */

    h1 {
        margin-top: clamp(3rem, 12vw, 9rem);
        font-size: clamp(3.5rem, 14vw, 13rem);
        font-weight: 850;
        line-height: 0.88;
        letter-spacing: -0.045em;
        text-wrap: balance;
    }

    .headline,
    .location {
        font-size: clamp(1.375rem, 3.2vw, 2.75rem);
        line-height: 1.15;
        letter-spacing: -0.02em;
    }

    .headline {
        margin-top: clamp(1rem, 2.5vw, 2rem);
        font-weight: 600;
    }

    .location {
        display: flex;
        align-items: center;
        gap: 0.3em;
        font-weight: 300;
    }

    .location :global(.icon) {
        width: 0.75em;
        height: 0.75em;
        stroke-width: 1.5;
    }

    /* Labels: small headings that sit on a 2px rule */

    .label {
        padding-top: 0.75rem;
        border-top: 2px solid var(--ink);
        font-size: 1rem;
        font-weight: 700;
    }

    /* About and Contact */

    .intro {
        display: grid;
        gap: clamp(2.5rem, 5vw, 4rem) var(--gap);
        margin-top: clamp(3.5rem, 9vw, 7.5rem);
    }

    .intro .label {
        margin-bottom: 1rem;
    }

    .about :global(p) {
        max-width: 34ch;
        font-size: clamp(1.25rem, 1.6vw + 0.6rem, 1.875rem);
        line-height: 1.35;
        letter-spacing: -0.012em;
    }

    .contact > p {
        max-width: 32ch;
    }

    .contact-links {
        display: grid;
        justify-items: start;
        gap: 0.35rem;
        margin-top: 1.25rem;
    }

    /* Contact links, and the LinkedIn and GitHub links again in the footer */
    .contact-links,
    .footer-links {
        font-size: clamp(1.25rem, 1.4vw + 0.7rem, 1.75rem);
        font-weight: 650;
        letter-spacing: -0.015em;
    }

    .contact-links a,
    .footer-links a {
        display: inline-flex;
        align-items: center;
        gap: 0.45em;
        overflow-wrap: anywhere;
    }

    /* Full text size on phones, where the text is at its smallest */
    .contact-links :global(.icon),
    .contact-links :global(.logo),
    .footer-links :global(.logo) {
        flex: none;
        width: 1em;
        height: 1em;
    }

    @media (min-width: 40rem) {
        .contact-links :global(.icon),
        .contact-links :global(.logo),
        .footer-links :global(.logo) {
            width: 0.8em;
            height: 0.8em;
        }
    }

    @media (min-width: 56rem) {
        .intro {
            grid-template-columns: 7fr 5fr;
        }
    }

    /* Sections hang from a 6px rule */

    .block {
        margin-top: clamp(5rem, 12vw, 10rem);
    }

    .wall {
        padding-top: 0.5rem;
        border-top: 6px solid var(--ink);
        font-size: clamp(2.75rem, 8.5vw, 7.5rem);
        font-weight: 850;
        line-height: 0.95;
        letter-spacing: -0.045em;
    }

    /* AI-first: a statement at near-display size, then four points */

    .ai-statement :global(p) {
        max-width: 26ch;
        margin-top: clamp(1.5rem, 4vw, 3rem);
        font-size: clamp(1.625rem, 3.2vw + 0.5rem, 3.5rem);
        font-weight: 700;
        line-height: 1.08;
        letter-spacing: -0.03em;
        text-wrap: balance;
    }

    /* Points are rows on the Projects grid: icon where the year sits, then title, then text */

    .ai-points {
        margin-top: clamp(2.5rem, 6vw, 4.5rem);
    }

    .ai-point {
        display: grid;
        grid-template-columns: auto 1fr;
        align-items: center;
        gap: 0.5rem 0.6rem;
        padding: clamp(1.25rem, 2.5vw, 2rem) 0;
        border-top: 1px solid var(--ink);
    }

    .ai-point :global(.icon) {
        width: 1.25rem;
        height: 1.25rem;
    }

    .ai-point h3 {
        font-size: clamp(1.375rem, 2.2vw, 2rem);
        font-weight: 750;
        line-height: 1.1;
        letter-spacing: -0.025em;
    }

    .ai-point p {
        grid-column: 1 / -1;
        max-width: 60ch;
    }

    @media (min-width: 56rem) {
        .ai-point {
            grid-template-columns: 2fr 5fr 5fr;
            align-items: baseline;
            gap: 0.75rem var(--gap);
        }

        .ai-point :global(.icon) {
            align-self: start;
            width: 1.5rem;
            height: 1.5rem;
        }

        .ai-point p {
            grid-column: auto;
        }
    }

    /* Projects */

    .works {
        margin-top: clamp(2rem, 5vw, 4rem);
    }

    .work {
        display: grid;
        gap: 0.75rem var(--gap);
        padding: clamp(1.5rem, 3vw, 2.5rem) 0;
        border-top: 1px solid var(--ink);
    }

    .work-year {
        font-size: clamp(1.125rem, 1.5vw, 1.375rem);
        font-weight: 700;
        font-variant-numeric: tabular-nums;
    }

    .work h3 {
        font-size: clamp(1.75rem, 3.4vw, 3rem);
        font-weight: 750;
        line-height: 1.02;
        letter-spacing: -0.03em;
        text-wrap: balance;
    }

    .work-client {
        margin-top: 0.75rem;
        font-weight: 600;
    }

    .work-agency,
    .work-stack {
        display: flex;
        align-items: flex-start;
        gap: 0.5em;
    }

    .work-agency {
        font-weight: 300;
    }

    /* Centred on the first line of text, which is 1.5em tall */
    .work-agency :global(.icon),
    .work-stack :global(.icon) {
        width: 1em;
        height: 1em;
        margin-top: 0.25em;
    }

    .work-body :global(ul) {
        display: grid;
        gap: 0.5rem;
        max-width: 60ch;
    }

    .work-stack {
        margin-top: 1rem;
        font-size: 0.9375rem;
        font-weight: 600;
    }

    .work-link {
        display: inline-flex;
        align-items: center;
        gap: 0.35em;
        margin-top: 1.25rem;
        font-weight: 650;
    }

    @media (min-width: 56rem) {
        .work {
            grid-template-columns: 2fr 5fr 5fr;
        }
    }

    .more-title {
        margin-top: clamp(2.5rem, 5vw, 4rem);
    }

    .more {
        margin-top: 1rem;
    }

    .more li {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 0 var(--gap);
        padding: 0.7rem 0;
        border-bottom: 1px solid var(--ink);
    }

    .more-name {
        font-weight: 650;
    }

    .more-name a {
        display: inline-flex;
        align-items: center;
        gap: 0.3em;
    }

    .more-name :global(.icon) {
        width: 0.75em;
        height: 0.75em;
    }

    .more-client {
        font-weight: 300;
    }

    .more-year {
        grid-column: 2;
        font-variant-numeric: tabular-nums;
    }

    @media (max-width: 55.99rem) {
        .more-name {
            grid-row: 1;
        }
    }

    @media (min-width: 56rem) {
        .more li {
            grid-template-columns: 2fr 5fr 5fr;
        }

        .more-year {
            grid-column: auto;
        }
    }

    /* Experience: rows on the Projects grid, dates where the year sits */

    .roles {
        margin-top: clamp(2rem, 5vw, 4rem);
    }

    .role {
        display: grid;
        gap: 0.35rem var(--gap);
        padding: clamp(1.25rem, 2.5vw, 2rem) 0;
        border-top: 1px solid var(--ink);
    }

    .role-dates {
        font-weight: 300;
        font-variant-numeric: tabular-nums;
    }

    .role-dates strong {
        font-weight: 700;
    }

    .role h3 {
        font-size: clamp(1.5rem, 2.6vw, 2.25rem);
        font-weight: 750;
        line-height: 1.05;
        letter-spacing: -0.025em;
    }

    .progression {
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem 0.5rem;
    }

    .progression li {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    @media (min-width: 56rem) {
        .role {
            grid-template-columns: 2fr 5fr 5fr;
            align-items: baseline;
        }
    }

    /* Skills */

    .skills {
        display: grid;
        gap: 2rem var(--gap);
        margin-top: clamp(2rem, 5vw, 4rem);
    }

    .skill-group ul {
        display: grid;
        gap: 0.3rem;
        margin-top: 0.75rem;
        font-size: clamp(1.375rem, 0.5vw + 1.2rem, 1.5rem);
        font-weight: 500;
        line-height: 1.35;
        letter-spacing: -0.01em;
    }

    .skill-group li {
        display: flex;
        align-items: center;
        gap: 0.5em;
    }

    /* Full text size on phones, where detailed marks need every pixel */
    .skill-group :global(.logo) {
        flex: none;
        width: 1em;
        height: 1em;
    }

    @media (min-width: 40rem) {
        .skills {
            grid-template-columns: repeat(2, 1fr);
        }

        .skill-group :global(.logo) {
            width: 0.85em;
            height: 0.85em;
        }
    }

    @media (min-width: 64rem) {
        .skills {
            grid-template-columns: repeat(4, 1fr);
        }
    }

    /*
     * Rust: a joke in three beats, set as display type, where weight does the timing: the setup
     * at statement weight, the confession light, the punchline heavy and larger. Then the serious
     * answer, a row on the Projects grid.
     */

    .beats {
        display: grid;
        gap: 0.5em;
        margin-top: clamp(1.5rem, 4vw, 3rem);
        font-size: clamp(1.625rem, 3.2vw + 0.5rem, 3.5rem);
        line-height: 1.08;
        letter-spacing: -0.03em;
    }

    .setup {
        max-width: 26ch;
        font-weight: 700;
        text-wrap: balance;
    }

    .confession {
        font-weight: 300;
    }

    .punchline {
        font-size: 1.5em;
        font-weight: 850;
        line-height: 0.95;
        letter-spacing: -0.045em;
        text-wrap: balance;
    }

    .rust-answer {
        display: grid;
        gap: 1rem var(--gap);
        margin-top: clamp(2.5rem, 6vw, 4.5rem);
        padding-top: clamp(1.25rem, 2.5vw, 2rem);
        border-top: 1px solid var(--ink);
    }

    .rust-answer :global(p) {
        max-width: 60ch;
    }

    /* The sign-off line, at the size of an AI-first point title */
    .rust-answer :global(strong) {
        display: block;
        font-size: clamp(1.375rem, 2.2vw, 2rem);
        font-weight: 750;
        line-height: 1.1;
        letter-spacing: -0.025em;
    }

    @media (min-width: 56rem) {
        .rust-answer {
            grid-template-columns: 2fr 5fr 5fr;
        }

        .rust-answer :global(p) {
            grid-column: 2 / -1;
        }
    }

    /* Footer: the page ends at the email address, with LinkedIn and GitHub beneath it */

    .footer {
        margin-top: clamp(6rem, 14vw, 12rem);
        padding: 1rem 0 clamp(1.5rem, 3vw, 2.5rem);
        border-top: 6px solid var(--ink);
    }

    .sign-off {
        font-size: clamp(1.75rem, 6.2vw, 6rem);
        font-weight: 800;
        line-height: 1;
        letter-spacing: -0.04em;
        overflow-wrap: anywhere;
    }

    .sign-off a {
        text-decoration-thickness: 0.06em;
        text-underline-offset: 0.12em;
    }

    .footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem 1.5em;
        margin-top: clamp(1.25rem, 3vw, 2rem);
    }

    .footer-row {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 0.5rem 2rem;
        margin-top: clamp(2rem, 5vw, 4rem);
        font-size: 0.9375rem;
    }

    .footer-row a {
        display: inline-flex;
        align-items: center;
        gap: 0.35em;
        font-weight: 600;
    }
</style>
