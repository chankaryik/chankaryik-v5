---
import Icon from '../components/Icon.astro'
import Base from '../layouts/Base.astro'
---

<Base title="Page not found — Chan Kar Yik" description="This page does not exist.">
    <header class="masthead">
        <a class="home" href="/">
            Chan Kar Yik
        </a>
    </header>
    <main>
        <h1>Page not found</h1>
        <p class="back">
            <a href="/">
                <Icon name="arrow-right" /> Go to the home page
            </a>
        </p>
    </main>
</Base>

<style>
    .masthead {
        padding: clamp(1rem, 2.5vw, 2rem) 0 0.75rem;
        border-bottom: 2px solid var(--ink);
    }

    .home {
        font-size: 0.9375rem;
        font-weight: 600;
        text-decoration: none;
    }

    main {
        padding-bottom: clamp(3rem, 8vw, 6rem);
    }

    h1 {
        margin-top: clamp(3rem, 12vw, 9rem);
        padding-top: 0.5rem;
        border-top: 6px solid var(--ink);
        font-size: clamp(3rem, 11vw, 9.5rem);
        font-weight: 850;
        line-height: 0.9;
        letter-spacing: -0.045em;
        text-wrap: balance;
    }

    .back {
        margin-top: clamp(2rem, 5vw, 3.5rem);
        font-size: clamp(1.25rem, 1.4vw + 0.7rem, 1.75rem);
        font-weight: 650;
        letter-spacing: -0.015em;
    }

    .back a {
        display: inline-flex;
        align-items: center;
        gap: 0.45em;
    }

    .back :global(.icon) {
        width: 0.8em;
        height: 0.8em;
    }
</style>
