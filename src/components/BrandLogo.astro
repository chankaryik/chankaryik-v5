---
// A brand's own logo (a skill, or a contact link), drawn in the text colour: from Simple Icons
// (CC0) where it has one, otherwise copied in by hand below. Names with no logo get an empty
// slot of the same size, so a list of skills stays aligned.
import * as icons from 'simple-icons'

interface Props {
    name: string
}

const slugs: Record<string, string> = {
    Vue: 'Vuedotjs',
    Nuxt: 'Nuxt',
    React: 'React',
    'Next.js': 'Nextdotjs',
    TypeScript: 'Typescript',
    'Tailwind CSS': 'Tailwindcss',
    Sass: 'Sass',
    Pinia: 'Pinia',
    Figma: 'Figma',
    Laravel: 'Laravel',
    'Inertia.js': 'Inertia',
    PHP: 'Php',
    'C#/.NET': 'Dotnet',
    Umbraco: 'Umbraco',
    WordPress: 'Wordpress',
    Strapi: 'Strapi',
    Stripe: 'Stripe',
    Vercel: 'Vercel',
    DigitalOcean: 'Digitalocean',
    'GitHub Actions': 'Githubactions',
    'Claude Code': 'Claude',
    GitHub: 'Github',
}

// Logos Simple Icons does not carry, copied in with the colour and shading layers dropped.
// Shapes are separate paths so overlaps stay filled; `evenOdd` cuts inner shapes out instead.
type Logo = { viewBox: string; paths: string[]; evenOdd?: boolean }

const ownLogos: Record<string, Logo> = {
    // Microsoft Azure Public Service Icons V23, Icons/other/10018-icon-service-Azure-A.svg
    Azure: {
        viewBox: '0 0 18 18',
        paths: [
            'M5.33492 1.37491C5.44717 1.04229 5.75909 0.818359 6.11014 0.818359H11.25L5.91513 16.6255C5.80287 16.9581 5.49095 17.182 5.13991 17.182H1.13968C0.579936 17.182 0.185466 16.6325 0.364461 16.1022L5.33492 1.37491Z',
            'M13.5517 11.4546H5.45126C5.1109 11.4546 4.94657 11.8715 5.19539 12.1037L10.4005 16.9618C10.552 17.1032 10.7515 17.1819 10.9587 17.1819H15.5453L13.5517 11.4546Z',
            'M12.665 1.37478C12.5528 1.04217 12.2409 0.818237 11.8898 0.818237H6.13629H6.16254C6.51358 0.818237 6.82551 1.04217 6.93776 1.37478L11.9082 16.1021C12.0872 16.6324 11.6927 17.1819 11.133 17.1819H11.0454H16.8603C17.42 17.1819 17.8145 16.6324 17.6355 16.1021L12.665 1.37478Z',
        ],
    },
    // The OpenAI mark, supplied by Chan Kar Yik (Simple Icons' former OpenAI icon)
    Codex: {
        viewBox: '0 0 24 24',
        paths: [
            'M22.282 9.821a6 6 0 0 0-.516-4.91a6.05 6.05 0 0 0-6.51-2.9A6.065 6.065 0 0 0 4.981 4.18a6 6 0 0 0-3.998 2.9a6.05 6.05 0 0 0 .743 7.097a5.98 5.98 0 0 0 .51 4.911a6.05 6.05 0 0 0 6.515 2.9A6 6 0 0 0 13.26 24a6.06 6.06 0 0 0 5.772-4.206a6 6 0 0 0 3.997-2.9a6.06 6.06 0 0 0-.747-7.073M13.26 22.43a4.48 4.48 0 0 1-2.876-1.04l.141-.081l4.779-2.758a.8.8 0 0 0 .392-.681v-6.737l2.02 1.168a.07.07 0 0 1 .038.052v5.583a4.504 4.504 0 0 1-4.494 4.494M3.6 18.304a4.47 4.47 0 0 1-.535-3.014l.142.085l4.783 2.759a.77.77 0 0 0 .78 0l5.843-3.369v2.332a.08.08 0 0 1-.033.062L9.74 19.95a4.5 4.5 0 0 1-6.14-1.646M2.34 7.896a4.5 4.5 0 0 1 2.366-1.973V11.6a.77.77 0 0 0 .388.677l5.815 3.354l-2.02 1.168a.08.08 0 0 1-.071 0l-4.83-2.786A4.504 4.504 0 0 1 2.34 7.872zm16.597 3.855l-5.833-3.387L15.119 7.2a.08.08 0 0 1 .071 0l4.83 2.791a4.494 4.494 0 0 1-.676 8.105v-5.678a.79.79 0 0 0-.407-.667m2.01-3.023l-.141-.085l-4.774-2.782a.78.78 0 0 0-.785 0L9.409 9.23V6.897a.07.07 0 0 1 .028-.061l4.83-2.787a4.5 4.5 0 0 1 6.68 4.66zm-12.64 4.135l-2.02-1.164a.08.08 0 0 1-.038-.057V6.075a4.5 4.5 0 0 1 7.375-3.453l-.142.08L8.704 5.46a.8.8 0 0 0-.393.681zm1.097-2.365l2.602-1.5l2.607 1.5v2.999l-2.597 1.5l-2.607-1.5Z',
        ],
    },
    // Devicon's LinkedIn mark (MIT), as used in v4's public/icons/linkedin.svg: the square with
    // the "in" cut out of it
    LinkedIn: {
        viewBox: '0 0 128 128',
        paths: [
            'M116 3H12a8.91 8.91 0 0 0-9 8.8v104.42a8.91 8.91 0 0 0 9 8.78h104a8.93 8.93 0 0 0 9-8.81V11.77A8.93 8.93 0 0 0 116 3ZM21.06 48.73h18.11V107H21.06zm9.06-29a10.5 10.5 0 1 1-10.5 10.49a10.5 10.5 0 0 1 10.5-10.49m20.41 29h17.36v8h.24c2.42-4.58 8.32-9.41 17.13-9.41C103.6 47.28 107 59.35 107 75v32H88.89V78.65c0-6.75-.12-15.44-9.41-15.44s-10.87 7.36-10.87 15V107H50.53z',
        ],
        evenOdd: true,
    },
}

const { name } = Astro.props
const slug = slugs[name]
const simpleIcon = slug
    ? (icons as Record<string, { path: string } | undefined>)[`si${slug}`]
    : undefined
const logo: Logo | undefined =
    ownLogos[name] ?? (simpleIcon && { viewBox: '0 0 24 24', paths: [simpleIcon.path] })
---

{logo ? (
    <svg
        class="logo"
        viewBox={logo.viewBox}
        width="24"
        height="24"
        aria-hidden="true"
        focusable="false"
        fill="currentColor"
        fill-rule={logo.evenOdd ? 'evenodd' : undefined}
    >
        {logo.paths.map((d) => (
            <path d={d} />
        ))}
    </svg>
) : (
    <span class="logo" aria-hidden="true" />
)}
