---
// Monochrome inline icons drawn on one 20px grid with a 2px stroke. They inherit the text
// colour and are hidden from assistive tech, so the text beside them must carry the meaning.
interface Props {
    name: keyof typeof paths
    class?: string
}

const paths = {
    'arrow-right': 'M3 10h13M11 4.5 16.5 10 11 15.5',
    'arrow-up-right': 'M5.5 14.5l9-9M7 5.5h7.5V13',
    'arrow-up': 'M10 17V4M4.5 9.5 10 4l5.5 5.5',
    // "via": delivered through an Agency
    via: 'M4.5 3v6.5a3 3 0 0 0 3 3h9M12.5 8.5l4 4-4 4',
    pin: 'M10 18s5.5-5.3 5.5-9.75a5.5 5.5 0 0 0-11 0C4.5 12.7 10 18 10 18ZM10 10a1.75 1.75 0 1 0 0-3.5 1.75 1.75 0 0 0 0 3.5Z',
    mail: 'M2.5 4.5h15v11h-15zM2.5 5.5 10 11l7.5-5.5',
    person: 'M10 9.5a3.25 3.25 0 1 0 0-6.5 3.25 3.25 0 0 0 0 6.5ZM3.5 17.5c.6-3.4 3.2-5.5 6.5-5.5s5.9 2.1 6.5 5.5',
    code: 'M7 5.5 2.5 10 7 14.5M13 5.5l4.5 4.5-4.5 4.5',
    layers: 'M10 2.5 2.5 6.5l7.5 4 7.5-4-7.5-4ZM2.5 10l7.5 4 7.5-4M2.5 13.5l7.5 4 7.5-4',
    chat: 'M3 3.5h14v10H9l-4.5 3.5v-3.5H3z',
    loop: 'M16 8.5a6.2 6.2 0 0 0-11.5-1.5M4 11.5a6.2 6.2 0 0 0 11.5 1.5M16.5 3v5h-5M3.5 17v-5h5',
}

const { name, class: className } = Astro.props
---

<svg
    class:list={['icon', className]}
    viewBox="0 0 20 20"
    width="20"
    height="20"
    aria-hidden="true"
    focusable="false"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linejoin="round"
>
    <path d={paths[name]}></path>
</svg>
